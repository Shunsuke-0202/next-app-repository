{
  "name": "app-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm run lint && npm run test && npm run build",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker build -t app-service-next:prod .",
    "deploy:appservice": "bash ./scripts/deploy-appservice.sh"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
